---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import hero from '../assets/img/hero.jpg';
import zerspanung from '../assets/img/zerspanung.jpg';
import moeglichkeiten from '../assets/img/moeglichkeiten.jpg';
import international from '../assets/img/international.jpg';
import Leistungskarten from '../components/Leistungskarten.astro';

const features = [
  { img: international, alt: 'Blick in die Werkstatthalle mit Dreh- und Fräsmaschinen', href: '/maschinenpark/', title: 'Unsere Maschinen', text: 'Wir setzen Maschinen der Firmen DMG und Boehringer ein. Erfahren Sie mehr über unsere eingesetzten Maschinen, deren Spezifikationen und vielfältigen Einsatzmöglichkeiten.' },
  { img: moeglichkeiten, alt: 'Fräsmaschine in der Werkstatt', href: '/maschinenpark/#moeglichkeiten', title: 'Unsere Möglichkeiten', text: 'Unsere Maschinen erlauben es uns, individuelle Kundenwünsche umzusetzen. Lassen Sie sich persönlich von uns beraten!' },
  { img: hero, alt: 'Gedrehte Präzisionsteile aus Metall', href: '/kontakt/', title: 'Wir arbeiten international mit Firmen zusammen', text: 'Wir sind breit aufgestellt und wickeln auch Projekte für unsere internationalen Kunden ab. Gerne können Sie für ein persönliches Gespräch Kontakt mit uns aufnehmen. Unser kompetentes Personal unterstützt Sie bei Ihrem Vorhaben.' },
];
---
<Base title="Präzisionsdreh- und Frästeile aus Gronau-Epe">
  <section class="hero-split">
    <div class="container hero-grid">
      <div>
        <p class="hero-kicker">H.H. Niesing GmbH, Gronau-Epe</p>
        <h1>Präzisionsdreh- und Frästeile</h1>
        <p class="hero-lead">Einzelteile und Kleinserien, Lohnfertigung, Maschinenbau und Webblätter – gefertigt in unserer Werkstatt im Münsterland.</p>
        <p class="btn-row">
          <a href="/kontakt/" class="btn btn-green">Kontakt aufnehmen</a>
          <a href="/leistungen/" class="btn btn-outline">Leistungen ansehen</a>
        </p>
      </div>
      <figure class="hero-photo">
        <Image src={zerspanung} alt="Drehmaschine von MAG Boehringer in der Werkstatt der H.H. Niesing GmbH" widths={[600, 900, 1300]} sizes="(max-width: 900px) 100vw, 600px" loading="eager" fetchpriority="high" />
      </figure>
    </div>
    <div class="container">
      <ul class="facts">
        <li><strong>Einzelteil bis Kleinserie</strong><span>Nach Zeichnung, Skizze oder Muster</span></li>
        <li><strong>Soforthilfe</strong><span>Schnelle Lösung bei Maschinenstillstand</span></li>
        <li><strong>Alles aus einer Hand</strong><span>Mit unseren Systemlieferanten</span></li>
        <li><strong>Seit Jahrzehnten</strong><span>Familienunternehmen im Münsterland</span></li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Unsere Leistungen</h2>
      <Leistungskarten />
    </div>
  </section>

  <section class="about">
    <div class="container about-inner">
      <div>
        <h2>Wer wir sind</h2>
        <p class="sub">und was wir bieten</p>
      </div>
      <p>
        Die Firma H.H. Niesing GmbH ist ein mittelständisches Familienunternehmen im münsterländischen
        Gronau-Epe. Wir sind spezialisiert auf die Einzel- und Kleinserienfertigung in den Bereichen
        Metallverarbeitung sowie der klassischen Lohnfertigung und dem Webereibedarf. Wir sind ein flexibler,
        zuverlässiger und präziser Partner! Mit unseren Systemlieferanten sind wir in der Lage, Ihnen komplette
        Lösungen in kürzester Produktionszeit aus einer Hand zu bieten.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {features.map((f, i) => (
        <div class:list={['feature', { reverse: i % 2 === 1 }]}>
          <div>
            <h2>{f.title}</h2>
            <p>{f.text}</p>
            <a href={f.href} class="btn btn-outline">Mehr erfahren</a>
          </div>
          <div class="feature-media">
            <Image src={f.img} alt={f.alt} widths={[500, 900]} sizes="(max-width: 900px) 100vw, 520px" />
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="quote">
    <div class="container">
      <blockquote>
        <p>„Wenn alle gemeinsam vorankommen, dann stellt sich der Erfolg von selbst ein.“</p>
        <cite>Henry Ford, amerikanischer Industrieller und Gründer der Ford Motor Company</cite>
      </blockquote>
    </div>
  </section>

  <section class="cta">
    <div class="container">
      <h2>Sie haben Fragen?</h2>
      <p>
        Bereits seit Jahrzehnten vertrauen uns unsere Kunden. Überzeugen auch Sie sich von unserer
        Leistungsfähigkeit. Nehmen Sie mit uns Kontakt auf und vereinbaren Sie einen unverbindlichen Termin für
        ein persönliches Gespräch. Überzeugen Sie sich dabei direkt von unserer Qualität.
      </p>
      <a href="/kontakt/" class="btn btn-green">Sprechen Sie mit uns!</a>
    </div>
  </section>
</Base>
